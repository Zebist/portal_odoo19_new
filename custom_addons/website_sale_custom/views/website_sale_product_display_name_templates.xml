<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        商店 QWeb 多处写死 product.name，与后台 display_name（含 default_code）不一致。
        改为 display_name（product.template 的 display_name 本身即带 default_code）。
        1. 产品详情页面包屑末级 + 页面标题：website_sale.product / product_title
        2. 产品列表等卡片：website_sale.products_item
        3. 同 1
        4. 购物车建议配件 + 详情页替代商品片段若用 products_item 则已覆盖；片段默认模板已为 display_name。
    -->

    <!-- 2. 产品列表 / 心愿单等同款卡片（website_sale.products_item） -->
    <template id="products_item_display_name" inherit_id="website_sale.products_item" name="Custom sale: product tile use display_name">
        <xpath expr="//form[@role='article']" position="attributes">
            <attribute name="t-att-aria-label">product.display_name</attribute>
        </xpath>
        <!-- 核心模板用 t-attf-class，无静态 class，不能用 contains(@class,...) -->
        <xpath expr="//a[@t-att-title='product.name']" position="attributes">
            <attribute name="t-att-title">product.display_name</attribute>
        </xpath>
        <xpath expr="//h2[contains(@class, 'o_wsale_products_item_title')]//span[@t-field='product.name']" position="replace">
            <span t-field="product.display_name"/>
        </xpath>
    </template>

    <!-- 1+3. 产品详情：浏览器标题、面包屑末级（与后台 display_name 一致） -->
    <template id="product_page_display_name" inherit_id="website_sale.product" name="Custom sale: product page title and breadcrumb use display_name">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title" t-value="product.display_name"/>
        </xpath>
        <xpath expr="//li[contains(@class, 'breadcrumb-item') and contains(@class, 'active')]//span[@t-field='product.name']" position="replace">
            <span t-field="product.display_name"/>
        </xpath>
    </template>

    <template id="product_title_display_name" inherit_id="website_sale.product_title" name="Custom sale: product H1 use display_name">
        <xpath expr="//h1[@t-field='product.name']" position="replace">
            <h1
                t-attf-class="h3 {{'mb-3' if not product.description_ecommerce and not is_view_active('website_sale.product_comment') else ''}}"
                t-field="product.display_name"
            >
                Product Name
            </h1>
        </xpath>
    </template>

    <!-- 4. 购物车「建议配件」：与后台一致的 display_name（含 default_code） -->
    <template id="suggested_products_display_name" inherit_id="website_sale.suggested_products_list" name="Custom sale: suggested accessories use full display_name">
        <xpath expr="//div[@name='suggested_product']//h6[contains(@class, 'align-top')]" position="replace">
            <h6
                class="align-top text-wrap"
                t-out="product.display_name"
            />
        </xpath>
    </template>

    <!--
        4b. 详情页「替代商品」区块使用 website 动态片段，默认模板已为 display_name；
        若主题改用 products_item，上一段 products_item 继承已覆盖。
    -->
</odoo>
